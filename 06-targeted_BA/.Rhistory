get_long_table <- function(quant, metadata) {
lq <- quant %>%
pivot_longer(names_to = "metabolite", values_to = "value", cols = ! matches("sample_name")) %>%
merge(metadata, ., by="sample_name", all.y=T)
return(lq)
}
get_percentages <- function(dat) {
# Given quantification table, gives % of total BAs and individual BAs
# -------
#  Input
# -------
# - dat
#       dat is quantification table from targeted BAs
#       each row is a sample; each col a BA
#       first col is sample_name
# -------
#  Output
# -------
# - ptab
#       ptab is the percentage table
total <- rowSums(dat[,-1])
ptab <- (dat[-1] / total )*100
ptab <- cbind(dat[,1], ptab)
return(ptab)
}
plot_ba_by_zt <- function(ltab, y_label="") {
# ---------
#. Input
# ---------
#  -ltab
#       ltab if long quantification table with metadata
#       required columns
# - y_label
#       lable or unit that "value" under ltab is
#       unit will be used to plot ylab
#       options could be: pmol/mg, pmol/ul, total BAs pmol, etc...
ltab %>%
ggplot(aes(y=value, fill=treatment_lower)) +
theme_bw() +
scale_fill_manual(values = c("#FF8000", "#0F99B2", "#000000")) +
scale_color_manual(values = c( "#FF8000", "#0F99B2", "#000000")) +
facet_wrap(~ metabolite, scales = "free_y") +
geom_boxplot(alpha=0.3,outlier.shape = NA, aes(x=zt_time, fill=treatment_lower,
color=treatment_lower, shape=treatment_lower)) +
geom_point(aes(x=zt_time, fill=treatment_lower, color=treatment_lower, shape=treatment_lower),
position = position_jitterdodge()) +
stat_compare_means(aes(x=zt_time), paired = F,label.y.npc=0.7, label="p.signif" ) +
theme(panel.grid = element_blank())+
ylab(y_label) -> p
return(p)
}
plot_ba_by_tx <- function(ltab, y_label="") {
# ---------
#. Input
# ---------
#  -ltab
#       ltab if long quantification table with metadata
#       required columns
# - y_label
#       lable or unit that "value" under ltab is
#       unit will be used to plot ylab
#       options could be: pmol/mg, pmol/ul, total BAs pmol, etc...
ltab %>%
ggplot(aes(x=treatment_lower, y=value, fill=treatment_lower)) +
theme_bw() +
scale_fill_manual(values = c("#FF8000", "#0F99B2", "#000000")) +
scale_color_manual(values = c( "#FF8000", "#0F99B2", "#000000")) +
facet_wrap(~ metabolite, scales = "free_y") +
geom_boxplot(alpha=0.3, aes(x=treatment_lower, fill=treatment_lower,
color=treatment_lower, shape=treatment_lower)) +
geom_point(aes(x=treatment_lower, fill=treatment_lower, color=treatment_lower, shape=treatment_lower),
position = position_jitterdodge()) +
#stat_compare_means(aes(x=treatment_lower), paired = F,label.y.npc=0.7, label="p.signif" ) +
ylab(y_label) -> p
return(p)
}
calculate_ba_ratio <- function(dat) {
# Input
#
#       dat is a quantification table, where first col is the sample name
# Define bile acid pairs --------------
# This might need to be updated if new BA pairs are available
ba_pairs <- data.frame(unconjugated = c("CA", "a-MCA", "b-MCA", "o-MCA", "HCA", "UDCA", "DCA", "CDCA"),
conjugated = c("TCA", "T-a-MCA", "T-b-MCA", "T-o-MCA", "THCA", "TUDCA", "TDCA", "TCDCA" ) )
# Calculate ratios for pairs that are present -------------
# For each BA pair
apply(ba_pairs, 1, function(x) {
# Test if both conj and unconj forms exist
if (all(x %in% colnames(dat)) == TRUE) {
# Calculate ratio for unconjugated/conjugated pair
unconj <- dat[x[[1]]]
conj <- dat[x[[2]]]
ratio <- log2(unconj/conj)
names(ratio) <- gsub("-", "", paste0(x[[1]], "/", x[[2]])  )
return(ratio)
}
}) -> ratios
# Combine output inn data frame
ratios <- cbind(dat[,1], do.call(cbind, ratios[!sapply(ratios, is.null)]))
# Return ratios of unconjugated/conjugated
return(ratios)
}
plot_ba_by_agestatus <- function(ltab, y_label="") {
# ---------
#. Input
# ---------
#  -ltab
#       ltab if long quantification table with metadata
#       required columns
# - y_label
#       lable or unit that "value" under ltab is
#       unit will be used to plot ylab
#       options could be: pmol/mg, pmol/ul, total BAs pmol, etc...
ltab %>%
ggplot(aes(y=value, x=age_status, fill=age_status)) +
theme_bw() +
scale_fill_manual(values = age_young_colors) +
scale_color_manual(values = age_young_colors) +
facet_wrap(~ metabolite, scales = "free_y") +
geom_boxplot(alpha=0.3,outlier.shape = NA, aes(color=age_status)) +
geom_point(aes(color=age_status, shape=phase), position = position_jitterdodge()) +
stat_compare_means(paired = F,label.y.npc=0.7, label="p.signif" ) +
ylab(y_label) -> p
return(p)
}
plot_ba_by_X <- function(ltab, y_label="",
fill_col = "age_status",
x_col = "zt_time",
group_colors = age_young_colors ) {
# ---------
#. Input
# ---------
#  -ltab
#       ltab if long quantification table with metadata
#       required columns
# - y_label
#       lable or unit that "value" under ltab is
#       unit will be used to plot ylab
#       options could be: pmol/mg, pmol/ul, total BAs pmol, etc...
ltab %>%
ggplot(aes(y=value, x=get(x_col), fill=get(fill_col), color=get(fill_col))) +
theme_bw() +
scale_fill_manual(values = group_colors) +
scale_color_manual(values = group_colors) +
facet_wrap(~ metabolite, scales = "free_y") +
geom_boxplot(alpha=0.3,outlier.shape = NA, aes(color=age_status)) +
geom_point(aes(shape=phase), position = position_jitterdodge()) +
stat_compare_means(paired = F,label.y.npc=0.7, label="p.signif" ) +
ylab(y_label) -> p
return(p)
}
