library(tidyverse)
library(data.table)
library(ggpubr)
#######################################################################
stderror <- function(x) sd(x, na.rm = TRUE) / sqrt(sum(!is.na(x)))
#serum 42/40 ratio
ser4240<-fread("phenotype/tgalftftrf_serum4240ratio.txt")%>%
group_by(condition)%>%mutate(mn_ratio=mean(r4240_ratio),sem=stderror(r4240_ratio))
p <- ggplot(ser4240, aes(x = condition, y = r4240_ratio, fill = condition)) +
geom_bar(stat = "summary", fun = "mean", width = 0.6, color = "black", alpha=0.3) +  # Bar plot with mean values
geom_jitter(shape = 21, size = 3, width = 0.1, aes(fill = condition)) +  # Jittered individual points
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2, fun.args = list(mult = 1))+  # Error bars for standard error
scale_fill_manual(values = c("purple4","forestgreen")) +  # Colors for bars
scale_y_continuous(expand=c(0,0), limits=c(0,0.4))+
labs(x = "", y = "Ratio", title = "Serum Aβ42/40") +
theme_pubr()+
theme(legend.position = "none",
axis.text.x = element_text(face = "bold"),
plot.title = element_text(face = "italic", hjust = 0.5))
p
ggsave("phenotype/tgalftftrf_serum4240ratio_se.pdf", plot=p,height=4, width=3.5)
#brain plaque
plaque<-fread("phenotype/adtrf_sum_plaquearea.txt")%>%
group_by(condition)%>%mutate(mn_ratio=mean(sum_plaque_area),sem=stderror(sum_plaque_area))
p <- ggplot(plaque, aes(x = condition, y = sum_plaque_area, fill = condition)) +
geom_bar(stat = "summary", fun = "mean", width = 0.6, color = "black", alpha=0.3) +  # Bar plot with mean values
geom_jitter(shape = 21, size = 3, width = 0.1, aes(fill = condition)) +  # Jittered individual points
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2, fun.args = list(mult = 1))+  # Error bars for standard error
scale_fill_manual(values = c("purple4","forestgreen")) +  # Colors for bars
scale_y_continuous(limits = c(-500, 80000), expand = c(0, 0))+
labs(x = "", y = "Total Plaque Area (um2)", title = "Sum of Plaque Area") +
theme_pubr()+
theme(legend.position = "none",
axis.text.x = element_text(face = "bold"),
plot.title = element_text(face = "italic", hjust = 0.5))
p
ggsave("phenotype/tgalftftrf_sumtotalplaque_se.pdf", plot=p,height=4, width=3.5)
